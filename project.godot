; Engine configuration file.
; SERAPHALL — proyecto Godot 4.7

config_version=5

[application]

config/name="Seraphall"
config/description="La Caída del Serafín / The Fall of the Seraph"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/icon_arconte.png"
boot_splash/bg_color=Color(0.05, 0.03, 0.07, 1)
boot_splash/show_image=false

[autoload]

G="*res://scripts/autoload/g.gd"
Audio="*res://scripts/autoload/audio.gd"
Prog="*res://scripts/autoload/prog.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.06, 1)
